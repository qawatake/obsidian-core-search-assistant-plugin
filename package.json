{
	"name": "obsidian-sample-plugin",
	"version": "0.12.0",
	"description": "This is a sample plugin for Obsidian (https://obsidian.md)",
	"main": "main.js",
	"packageManager": "pnpm@10.34.7",
	"engines": {
		"node": ">=24.0.0"
	},
	"type": "module",
	"scripts": {
		"fix:format": "biome format --write src",
		"lint:format": "biome format --check src",
		"fix:lint": "biome lint --write src",
		"lint": "biome check src",
		"typecheck": "tsc --noEmit",
		"fix": "biome check --write src",
		"dev": "node esbuild.config.mjs",
		"sass-build": "sass --no-source-map *.scss styles.css",
		"esbuild": "node esbuild.config.mjs production",
		"build": "pnpm esbuild && pnpm sass-build",
		"e2e:test": "playwright test --project e2e",
		"e2e": "pnpm build && pnpm e2e:test",
		"try": "node scripts/try.ts",
		"check": "node scripts/check-toolchain.mjs && node scripts/check-actions-pinned.mjs && node scripts/check-config-schema.mjs && pnpm lint && pnpm typecheck && pnpm build && node scripts/check-bundled-deps.mjs && node scripts/check-css-scope.mjs"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"svelte": "5.57.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@electron/asar": "4.3.1",
		"@playwright/test": "1.64.1",
		"@tsconfig/svelte": "5.0.8",
		"@types/node": "24.19.2",
		"electron": "43.8.0",
		"esbuild": "0.28.2",
		"esbuild-svelte": "0.9.5",
		"obsidian": "1.14.4",
		"sass": "1.105.2",
		"typescript": "5.9.3"
	},
	"hardenDeps": {
		"artifact": [
			"main.js",
			"manifest.json",
			"styles.css"
		]
	}
}
